<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.braintrust</groupId>
    <artifactId>braintrust-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>BrainTrust Platform</name>
    <description>Educational Platform with AI Features</description>

    <!-- ADD ALL YOUR MODULES -->
    <modules>
        <module>shared</module>
        <module>identity</module>
        <module>education</module>
        <module>aidetectition</module>
        <module>container-app</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- DEPENDENCY MANAGEMENT - SHARED ACROSS ALL MODULES -->
    <dependencyManagement>
        <dependencies>
            <!-- Internal modules versions -->
            <dependency>
                <groupId>com.braintrust</groupId>
                <artifactId>shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.braintrust</groupId>
                <artifactId>identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.braintrust</groupId>
                <artifactId>aidetectition</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.braintrust</groupId>
                <artifactId>education</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- COMMON DEPENDENCIES FOR ALL MODULES -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>