cat > .gitignore << 'EOF'
# Maven
target/
!maven-wrapper.jar
.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.swp
*.swo

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Application
*.jar
*.war
*.ear

# Temp files
*.tmp
*.temp
EOF



