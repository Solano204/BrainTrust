# =================================================================
# CORE APPLICATION & PROFILES
# =================================================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brainTrust
DB_USERNAME=postgres
DB_PASSWORD=12345

# =================================================================
# SECURITY CONFIGURATION
# =================================================================
JWT_SECRET=R2Y3NkwzQ3dYdE56TFNWZFQ0Q1R2R21HNDc1QkJYVlZqYnRCczk3Yg==
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000
JWT_ISSUER=https://api.braintrust.com

# SSL Configuration
SSL_ENABLED=false
SSL_KEYSTORE_PATH=classpath:keystore.p12
SSL_KEYSTORE_PASSWORD=changeit
SSL_KEY_ALIAS=braintrust

# Security Features
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
IP_WHITELIST_ENABLED=false
ADMIN_IPS=

# =================================================================
# EXTERNAL SERVICE CONFIGURATION
# =================================================================
AI_PYTHON_ANALYZE_URL=http://localhost:8001/analyze
AI_PYTHON_EXTRACT_URL=http://localhost:8000/extract
AI_MODEL_DEFAULT_TYPE=ENSEMBLE

# Document Storage
DOCUMENT_STORAGE_STRATEGY=parallel
DOCUMENT_STORAGE_LOCAL_BASE_PATH=./storage/documents
DOCUMENT_STORAGE_S3_BUCKET_NAME=braintrust-submissions
DOCUMENT_STORAGE_S3_REGION=us-east-1

# =================================================================
# MONITORING & LOGGING
# =================================================================
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
PROMETHEUS_ENABLED=true

# =================================================================
# DATABASE POOL (Hikari)
# =================================================================
DB_POOL_MAX=20
DB_POOL_MIN=5

# =================================================================
# JPA/HIBERNATE
# =================================================================
DDL_AUTO=validate
SHOW_SQL=false
FORMAT_SQL=false

# =================================================================
# ACTUATOR SECURITY
# =================================================================
HEALTH_SHOW_DETAILS=when-authorized